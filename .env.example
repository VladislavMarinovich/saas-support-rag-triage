# Copy this file to `.env` and fill in the values. `.env` is gitignored — never commit it.

# Which provider generate() uses: "anthropic" (default) or "vertex".
LLM_PROVIDER=anthropic

# Anthropic Claude — generates the KB and synthetic tickets.
# Create a key at https://console.anthropic.com  ("API Keys" -> "Create Key")
ANTHROPIC_API_KEY=

# Gemini via Vertex AI (bulk generation + embeddings). NO API key here — auth is
# Application Default Credentials: run `gcloud auth application-default login`.
# These are just the target project/region (not secrets); code defaults to them.
GOOGLE_CLOUD_PROJECT=polaris-triage-demo
GOOGLE_CLOUD_LOCATION=us-central1

# Pinecone (vector store for RAG retrieval — used from step 3 onward).
# Create a key at https://app.pinecone.io  ("API Keys")
PINECONE_API_KEY=
